---
import GridLayout from "@layouts/grid.astro";
import PostCard from "@components/post/postCard.astro";
import BackwardButton from "@components/backwardButton.astro";
import { getSortedPosts } from "@utils/post";
import { removeFileExtension } from "@utils/url";

export async function getStaticPaths() {
    const posts = await getSortedPosts();
    const categories = new Set();
    for (const p of posts) {
        const id = removeFileExtension(p.id);
        const first = id.split("/")[0];
        if (first) categories.add(first);
    }

    return Array.from(categories).map((c) => ({ params: { category: c } }));
}

const { category } = Astro.params;
const allPosts = await getSortedPosts();
const posts = allPosts.filter((p) => removeFileExtension(p.id).startsWith(`${category}/`));

const title = category;
const subtitle = `${posts.length} posts`;
---

<GridLayout title={title} description={subtitle}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <BackwardButton currentPath={Astro.url.pathname} />
            <div class="grid grid-cols-1 gap-6">
                {posts.map((entry) => (
                    <PostCard entry={entry} />
                ))}
            </div>
        </div>
    </div>
</GridLayout>
